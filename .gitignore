# --- Secrets: never commit credentials ---
# Any env-style file is ignored: ".env", ".env.local", "prod.env", " - Copy.env", ".env - Copy", ".env (1)",
# "Copy of .env", "x.env.bak" ... Put credentials in the cloud environment's secrets or a local, untracked
# .env; never create or upload them through the GitHub web UI. Only the blank template is allowed.
.env
.env*
*.env
*.env.*
!.env.example
*.token
*.pem
*.key
secrets/

# --- Data: databases, downloaded masters, reports and logs stay local ---
data/
logs/
reports/
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.wal
*.db
*.parquet
instrument_master/
api-scrip-master*.csv
security_id_list*.csv

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# --- Web interface (docs/WEBUI.md) ---
node_modules/
*.tsbuildinfo
# the prebuilt interface is kept so Windows users do not need Node.js; rebuild with build_frontend.bat
!webui/dist/
# data-directory choice saved by the Settings page (machine specific)
stockdata_web.json
