# --- Secrets: never commit credentials ---
# Any *.env file (".env", "prod.env", " - Copy.env" ...) is ignored. Put credentials in the cloud
# environment's secrets or a local, untracked .env; never edit/upload them through the GitHub web UI.
.env
.env.*
*.env
!.env.example
*.token
*.pem
*.key
secrets/

# --- Data: databases, downloaded masters, reports and logs stay local ---
data/
logs/
reports/
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.wal
*.db
*.parquet
instrument_master/
api-scrip-master*.csv
security_id_list*.csv

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store
