# TEMPLATE ONLY - placeholders, no real values. Never put real credentials in this file.
#
# For local use: copy to ".env" (git-ignored) on your own machine and fill it in.
# For cloud sessions: set DHAN_ACCESS_TOKEN / DHAN_CLIENT_ID as environment secrets instead.
# Never create, edit or upload a credentials file through the GitHub web UI: this repository may be public.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Other data providers (all optional; see docs/PROVIDERS_AND_AUTOMATION.md). They can also be entered on the Providers screen.
# FYERS_APP_ID=
# FYERS_ACCESS_TOKEN=                # short-lived: renewing it needs an interactive login
# UPSTOX_ANALYTICS_TOKEN=            # read-only token (preferred); or UPSTOX_ACCESS_TOKEN for an OAuth token
# STOCKDATA_PROVIDER=dhan            # default provider for command-line runs (dhan | fyers | upstox)

# Optional overrides
# STOCKDATA_DIR=data                 # folder holding the two DuckDB files
# STOCKDATA_RPS=3                    # requests per second (Dhan's documented limit is 5)
# DHAN_INTRADAY_DATE_FORMAT=datetime # datetime = "YYYY-MM-DD HH:MM:SS", date = "YYYY-MM-DD"
# DHAN_BASE_URL=https://api.dhan.co/v2
